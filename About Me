  <style>
    :root {
      --primary: #1a1a2e;
      --accent: #0f7173;
      --accent-light: #e0f2f1;
      --text: #2c2c2c;
      --text-light: #5a5a5a;
      --bg: #fafafa;
      --white: #ffffff;
      --border: #e0e0e0;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--text);
      background: var(--bg);
      line-height: 1.6;
    }

    /* NAV */
    nav {
      position: fixed; top: 0; width: 100%; z-index: 100;
      background: rgba(26, 26, 46, 0.95); backdrop-filter: blur(8px);
      padding: 14px 0;
    }
    nav .nav-inner {
      max-width: 960px; margin: 0 auto; padding: 0 20px;
      display: flex; justify-content: space-between; align-items: center;
    }
    nav .logo { color: var(--white); font-weight: 700; font-size: 1.1em; text-decoration: none; }
    nav .nav-links { display: flex; gap: 24px; list-style: none; }
    nav .nav-links a {
      color: rgba(255,255,255,0.75); text-decoration: none; font-size: 0.88em;
      font-weight: 500; transition: color 0.2s;
    }
    nav .nav-links a:hover { color: var(--white); }

    /* HERO */
    .hero {
      background: linear-gradient(135deg, var(--primary) 0%, #16213e 50%, var(--accent) 100%);
      color: var(--white);
      padding: 120px 20px 70px;
      text-align: center;
    }
    .hero h1 { font-size: 2.6em; font-weight: 700; margin-bottom: 8px; letter-spacing: -0.5px; }
    .hero .tagline { font-size: 1.2em; font-weight: 300; opacity: 0.9; margin-bottom: 24px; }
    .hero .contact-bar {
      display: flex; justify-content: center; gap: 24px; flex-wrap: wrap;
      font-size: 0.92em; opacity: 0.85;
    }
    .hero .contact-bar a { color: rgba(255,255,255,0.85); text-decoration: none; }
    .hero .contact-bar a:hover { color: var(--white); text-decoration: underline; }
    .hero .contact-bar span::before { content: " · "; opacity: 0.5; }
    .hero .contact-bar span:first-child::before { content: ""; }
    .hero .status-badge {
      display: inline-block; margin-top: 24px;
      background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.25);
      padding: 8px 22px; border-radius: 24px; font-size: 0.9em; font-weight: 500;
    }
    .hero .status-badge .dot {
      display: inline-block; width: 8px; height: 8px;
      background: #4caf50; border-radius: 50%; margin-right: 8px;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    .hero .cta-row { margin-top: 28px; display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }
    .btn-primary {
      display: inline-block; background: var(--white); color: var(--primary);
      padding: 12px 30px; border-radius: 28px; text-decoration: none;
      font-weight: 600; font-size: 0.95em; transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-primary:hover { transform: scale(1.04); box-shadow: 0 4px 16px rgba(0,0,0,0.2); }
    .btn-secondary {
      display: inline-block; background: transparent; color: var(--white);
      border: 1px solid rgba(255,255,255,0.4);
      padding: 12px 30px; border-radius: 28px; text-decoration: none;
      font-weight: 500; font-size: 0.95em; transition: background 0.2s;
    }
    .btn-secondary:hover { background: rgba(255,255,255,0.1); }

    /* CONTAINER */
    .container { max-width: 960px; margin: 0 auto; padding: 0 20px; }

    /* SECTION */
    section { padding: 64px 0; }
    section h2 {
      font-size: 1.6em; color: var(--primary); margin-bottom: 8px;
      padding-bottom: 12px; border-bottom: 3px solid var(--accent);
      display: inline-block;
    }
    section .section-subtitle {
      color: var(--text-light); font-size: 1em; margin-bottom: 32px;
    }

    /* INTRO */
    .intro-text {
      font-size: 1.08em; line-height: 1.85; color: var(--text-light);
      max-width: 800px; margin: 0 auto; text-align: center; padding: 48px 20px 0;
    }

    /* METRICS */
    .metrics-row {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 20px; margin-top: 32px; text-align: center;
    }
    .metric-box {
      background: var(--white); border: 1px solid var(--border);
      border-radius: 12px; padding: 24px;
    }
    .metric-box .number { font-size: 2.2em; font-weight: 700; color: var(--accent); }
    .metric-box .label { font-size: 0.85em; color: var(--text-light); margin-top: 4px; }

    /* SKILLS GRID */
    .skills-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px; margin-top: 32px;
    }
    .skill-card {
      background: var(--white); border: 1px solid var(--border);
      border-radius: 12px; padding: 28px; transition: box-shadow 0.3s, transform 0.3s;
    }
    .skill-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.08); transform: translateY(-2px); }
    .skill-card .icon { font-size: 2em; margin-bottom: 12px; }
    .skill-card h3 { font-size: 1.1em; color: var(--primary); margin-bottom: 8px; }
    .skill-card p { font-size: 0.9em; color: var(--text-light); line-height: 1.6; }

    /* EXPERIENCE */
    .experience-list { margin-top: 32px; }
    .exp-item {
      display: flex; gap: 20px; padding: 24px 0;
      border-bottom: 1px solid var(--border);
    }
    .exp-item:last-child { border-bottom: none; }
    .exp-logo {
      flex-shrink: 0; width: 56px; height: 56px;
      background: var(--accent-light); border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 0.75em; color: var(--accent); text-align: center;
    }
    .exp-details h3 { font-size: 1.05em; color: var(--primary); }
    .exp-details .company { font-size: 0.95em; color: var(--accent); font-weight: 600; }
    .exp-details .dates { font-size: 0.85em; color: var(--text-light); margin-bottom: 6px; }
    .exp-details p { font-size: 0.9em; color: var(--text-light); }

    /* TECH STACK */
    .tech-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
    .tech-tag {
      background: var(--accent-light); color: var(--accent);
      padding: 8px 16px; border-radius: 20px; font-size: 0.86em; font-weight: 500;
    }

    /* EDUCATION */
    .edu-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px; margin-top: 32px;
    }
    .edu-card {
      background: var(--white); border: 1px solid var(--border);
      border-radius: 12px; padding: 24px;
    }
    .edu-card h3 { color: var(--primary); font-size: 1.05em; }
    .edu-card .school { color: var(--accent); font-weight: 600; font-size: 0.95em; }
    .edu-card .year { color: var(--text-light); font-size: 0.85em; }
    .edu-card p { color: var(--text-light); font-size: 0.88em; margin-top: 8px; }

